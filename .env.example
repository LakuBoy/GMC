# Copy to .env.local and fill in. .env.local is ignored by git.
OSM_CONTACT=you@example.com        # contact sent to OpenStreetMap servers (usage policy)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Accounts, saved places and reviews (run `npm run db:migrate` once after setting DATABASE_URL)
DATABASE_URL=
NEXTAUTH_SECRET=                   # long random text, e.g. from: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3100
# Google sign-in (optional; the button appears when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
